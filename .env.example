# RaceResult feed URLs, one per slice.
# When unset, /api/results/[slice] serves mocks/raceresult-348237.json so dev works offline.
RACE_FEED_OVERALL=
RACE_FEED_MEN=
RACE_FEED_WOMEN=
RACE_FEED_TEAMS=

# Vercel KV. Optional locally — kvGet/kvSet fall back to an in-memory Map when these are unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
